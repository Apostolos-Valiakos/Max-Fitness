# Copy this file to .env and fill in your values.
# Never commit .env — it's in .gitignore.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Gym subscription plans
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# Mobile user tier upgrades
STRIPE_PRICE_USER_PAID=price_...
STRIPE_PRICE_USER_ULTRA=price_...

# Standalone (gym-less) trainer plan — single flat price, no tiers
STRIPE_PRICE_TRAINER=price_...

SITE_URL=http://localhost:5174

# ── SMTP (send-invite-email) ───────────────────────────────
# Gmail / Google Workspace: smtp.gmail.com, port 587.
# SMTP_PASSWORD must be a Gmail App Password, not your normal password —
# generate one at https://myaccount.google.com/apppasswords (requires 2FA on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=interventiobooking@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Ferrum
SMTP_FROM_EMAIL=interventiobooking@gmail.com

# ── ExerciseDB (sync-exercises) ─────────────────────────────
# RapidAPI key for exercisedb.p.rapidapi.com — free tier is 10 req/day,
# but sync-exercises fetches everything in one call (limit=1326).
EXERCISEDB_API_KEY=your-rapidapi-key