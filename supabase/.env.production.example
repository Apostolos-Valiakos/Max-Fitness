############################################################
# Supabase Self-Hosted — PRODUCTION template
#
# Copy this to `supabase/.env` on the VPS and fill it in — that copy is
# real secrets and stays gitignored (see .gitignore's `.env*` rule).
# This file itself has no secrets in it, only placeholders, so it's tracked.
#
# Generate JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY / POSTGRES_PASSWORD with:
#   ./deploy/generate-secrets.sh
#
# IMPORTANT: once real users exist, never regenerate JWT_SECRET or the two
# derived keys — doing so invalidates every issued session/token instantly.
############################################################

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
ANON_KEY=REPLACE_WITH_GENERATED_ANON_JWT
SERVICE_ROLE_KEY=REPLACE_WITH_GENERATED_SERVICE_ROLE_JWT
JWT_EXPIRY=604800

# ── Postgres ──────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# ── URLs ──────────────────────────────────────────────────
# api.yourdomain.com is Caddy's route to Kong (see deploy/Caddyfile) — this
# is what SUPABASE_PUBLIC_URL and both apps' VITE_SUPABASE_URL must point at.
SUPABASE_PUBLIC_URL=https://api.yourdomain.com
GOTRUE_SITE_URL=https://admin.yourdomain.com
GOTRUE_ADDITIONAL_REDIRECT_URLS=https://admin.yourdomain.com,https://app.yourdomain.com

# ── Auth / Mailer ─────────────────────────────────────────
# Kept true: AuthView.vue's self-serve signup flow assumes an immediate
# session with no email-confirmation step implemented client-side.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_HOST=smtp.gmail.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=FILL_ME_IN@gmail.com
GOTRUE_SMTP_PASS=FILL_ME_IN_16_CHAR_APP_PASSWORD
GOTRUE_SMTP_ADMIN_EMAIL=FILL_ME_IN@gmail.com
GOTRUE_SMTP_SENDER_NAME=Ferrum
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ── PostgREST ─────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── Storage ───────────────────────────────────────────────
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
STORAGE_FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=stub

# ── Studio ───────────────────────────────────────────────
# Not exposed publicly — reached only via SSH tunnel. Port is still needed
# so the container binds to 127.0.0.1:<this> on the VPS.
STUDIO_PORT=3001
STUDIO_DEFAULT_ORGANIZATION=Ferrum
STUDIO_DEFAULT_PROJECT=ferrum
