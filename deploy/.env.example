# Copy to deploy/.env and fill in — deploy/up.sh sources this alongside
# supabase/.env before calling docker compose, so every variable referenced
# by either compose file resolves correctly regardless of which file Compose
# would normally auto-load.

DOMAIN=yourdomain.com

# Same value as supabase/.env's ANON_KEY, and the same https://api.${DOMAIN}
# used there — these get baked into the frontend bundles at build time by
# Vite, so a value change means a rebuild, not just a container restart.
# Never add a service-role key here — admin-only operations go through
# service-role Edge Functions instead (see admin-portal/src/lib/adminApi.ts).
VITE_SUPABASE_URL=https://api.yourdomain.com
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SAME_ANON_KEY_AS_SUPABASE_ENV

VITE_RXDB_SYNC_DAYS=30
VITE_RXDB_PULL_INTERVAL=10000
