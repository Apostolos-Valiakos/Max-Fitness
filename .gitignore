# Secrets
.env
.env.production
.env.staging

# Node
node_modules/
dist/
.cache/

# Capacitor native
android/
ios/
.gradle/

# Docker local data — volumes contain generated secrets, never commit
supabase/volumes/db/data/
supabase/volumes/storage/
# Note: supabase/volumes/api/kong.yml IS tracked — it only holds ${VAR} placeholders,
# resolved from real env vars inside the kong container at startup, never written to disk.

# Claude Code local settings (contains API keys / allowlisted commands)
.claude/

# Editors
.vscode/settings.json
.idea/
*.swp
.DS_Store

.env*
# .env.example / .env.*.example are placeholder-only templates, safe (and meant) to commit
!.env.example
!**/.env.example
!.env*.example
*.sql.bak

# Supabase temp
supabase/.temp/

# Playwright / Vitest (tests live outside VCS)
playwright.config.ts
**/vitest.config.*
**/__tests__/
e2e/
playwright-report/
test-results/

# Generated reports
MAX_FITNESS_REPORT.html
GYM_ONBOARDING_REPORT.html

# Local Postgres dumps from deploy/backup.sh
deploy/backups/
